<dialog id="admin-account-drawer" class="drawer"
  aria-labelledby="admin-account-drawer-title"
  data-drawer-target="dialog"
  data-action="click->drawer#closeOnBackdrop">
  <div class="drawer-panel">
    <div class="drawer-header">
      <div class="account-user">
        <span class="avatar avatar-large" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </span>
        <div class="account-user-text">
          <h2 id="admin-account-drawer-title" class="account-name"><%= current_user.full_name %></h2>
          <p class="account-role"><%= t(".role") %></p>
        </div>
      </div>
      <button type="button" class="icon-button icon-button-small" data-action="drawer#close"
        title="<%= t(".aria.close") %>" aria-label="<%= t(".aria.close") %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="drawer-nav" aria-label="<%= t(".aria.account_links") %>">
      <%= link_to edit_user_registration_path, class: "drawer-link" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <%= t(".links.my_profile") %>
      <% end %>
      <%= link_to dashboard_index_path, class: "drawer-link" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"></path>
        </svg>
        <%= t(".links.user_view") %>
      <% end %>
      <% manager_reserve = current_user.managed_reserves.alphabetized.first || Reserve.alphabetized.first %>
      <% if manager_reserve %>
        <%= link_to manager_reserve_dashboard_path(manager_reserve), class: "drawer-link" do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21h18"></path>
            <path d="M5 21V10l7-5 7 5v11"></path>
            <path d="M9 21v-6h6v6"></path>
          </svg>
          <%= t(".links.manager_view") %>
        <% end %>
      <% end %>
    </nav>

    <div class="drawer-footer">
      <%= button_to destroy_user_session_path, method: :delete, class: "account-sign-out" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <%= t("layouts.admin_navbar.aria.sign_out") %>
      <% end %>
    </div>
  </div>
</dialog>
