<li
  id="institution-result-<%= result[:type] %>-<%= result[:id].to_s.parameterize %>"
  role="option"
  data-autocomplete-value="<%= result[:id] %>"
  data-autocomplete-label="<%= result[:name] %>"
  data-autocomplete-selection-type="<%= result[:type] %>"
>
  <strong><%= result[:name] %></strong>
  <% if result[:city].present? || result[:country].present? %>
    <span> - <%= [result[:city], result[:country]].compact_blank.join(" | ") %></span>
  <% end %>
</li>
