<turbo-frame id="personnel-table">
  <table class="personnel-table">
    <thead>
      <tr><th colspan="<%= ReservePersonnel::EMAIL_FLAGS.size + 1 %>"><%= t(".email_settings_for_reserve_personnel") %></th><td></td></tr>
      <tr>
        <td></td>
        <th><%= t(".name") %></th>
        <% ReservePersonnel::EMAIL_FLAGS.each do |flag| %>
          <%= tag.th t(".email_flags.#{flag}.label"), title: t(".email_flags.#{flag}.description"), class: "email-flag" %>
        <% end %>
        <th><%= link_to t("new"), new_manager_reserve_reserve_info_staff_and_notification_path(current_reserve), data: { "turbo-frame": "modal-content" } %></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "personnel", collection: personnels %>
    </tbody>
  </table>
  <dl class="personnel-table-legend">
    <% ReservePersonnel::EMAIL_FLAGS.each do |flag| %>
      <dt><%= t(".email_flags.#{flag}.label") %></dt>
      <dd><%= t(".email_flags.#{flag}.description") %></dd>
    <% end %>
  </dl>
</turbo-frame>
