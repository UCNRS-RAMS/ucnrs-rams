<section class="content">
  <header>
    Fiscal <%= @presenter.labeled_designated_fiscal_year %> Annual Report
  </header>

  <div class="fiscal-year-select">
    Fiscal year:
    <%= tag.div class: "dropdown", data: { controller: "dropdown" } do %>
      <%= tag.button @presenter.labeled_designated_fiscal_year,
        class: "dropdown-toggle",
        data: { action: "click->dropdown#toggle click@window->dropdown#hide" }
      %>
      <%= tag.div class: "dropdown-menu", data: { "dropdown-class": "show", "dropdown-target": "dropdown" } do %>
        <% @presenter.fiscal_year_ending_options.each do |fiscal, year_ending| %>
          <%= link_to fiscal, admin_reports_path(fiscal_year_ending: year_ending), class: "dropdown-item" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <table class="table-style1">
    <thead>
      <tr>
        <th>Reserve</th>
        <th class="part">Part 1</th>
        <th class="part">Part 2</th>
        <th class="part">Part 3</th>
        <th class="part">Part 4</th>
        <th class="part">Part 5</th>
        <th class="part">Part 6</th>
        <th class="part">Part 7</th>
      </tr>
    </thead>
    <tbody>
      <% if @presenter.annual_reports.present? %>
        <% @presenter.annual_reports.each do |ar_report| %>
          <tr>
            <%= tag.td ar_report.reserve.name, class: "reserve-name" %>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_1_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_1_approved)) %>
            </td>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_2_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_2_approved)) %>
            </td>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_3_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_3_approved)) %>
            </td>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_4_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_4_approved)) %>
            </td>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_5_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_5_approved)) %>
            </td>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_6_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_6_approved)) %>
            </td>
            <td class="part">
              <%= image_tag @presenter.icon_for_column(ar_report.part_7_approved),
                alt: t(@presenter.icon_alt_i18n_key(ar_report.part_7_approved)) %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr class="empty">
          <td colspan="8">No annual reports for <%= @presenter.labeled_designated_fiscal_year %>.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
